{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Total gRPC Requests",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(grpc_requests_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed gRPC Requests",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(grpc_failures_total)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by Service",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by(service,status)(grpc_requests_total)",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(grpc_request_duration_seconds_bucket[5m])) by (le,service,method))",
          "legendFormat": "{{service}} {{method}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "distributed-commerce"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "06 - gRPC Communication",
  "version": 1
}